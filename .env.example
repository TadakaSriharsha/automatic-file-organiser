FILEFLOW_SECRET_KEY=replace-with-a-long-random-secret
FILEFLOW_COOKIE_SECURE=true
FILEFLOW_DATA_DIR=/var/data/fileflow
FILEFLOW_DB_PATH=/var/data/fileflow/fileflow.sqlite3
FILEFLOW_CORS_ORIGINS=https://your-fileflow-domain.example
FILEFLOW_SMTP_HOST=smtp.example.com
FILEFLOW_SMTP_PORT=587
FILEFLOW_SMTP_USERNAME=your-smtp-user
FILEFLOW_SMTP_PASSWORD=replace-with-your-smtp-password
FILEFLOW_SMTP_FROM=FileFlow <noreply@example.com>
FILEFLOW_SMTP_TLS=true
